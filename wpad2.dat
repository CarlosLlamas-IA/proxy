	        shExpMatch(host, "*.hipercor.pt*") || shExpMatch(host, "*.hipercor.es") || shExpMatch(host, "*portal.gruposicor.com") ||
	        shExpMatch(host, "*.vortal.biz*") || shExpMatch(host, "*.fundacionareces.es") || shExpMatch(host, "*.haier.pt*") ||
	        shExpMatch(host, "*cdn.nft.grupoelcorteingles.es*") ||
	        shExpMatch(host, "*pocpre.correos.es") || shExpMatch(host, "*.viajeselcorteingles.*")) {
	             return "PROXY zsuser.eci.geci:80";
            }
        
        // Redes locales
        // Empezamos por la general 10/8
        if ((isInNet(host, "10.0.0.0", "255.0.0.0")) || (isInNet(host, "192.168.0.0", "255.255.0.0")) || 
            (isInNet(host, "181.220.164.2", "255.255.255.255")) || (isInNet(host, "181.220.164.1", "255.255.255.255")) ||
            (isInNet(host, "128.28.100.50", "255.255.255.255")) || (isInNet(host, "128.180.0.0", "255.255.0.0")) || 
            (isInNet(host, "128.181.0.0", "255.255.0.0")) || (isInNet(host, "172.26.0.0", "255.255.0.0")) || 
            (isInNet(host, "172.16.0.0", "255.240.0.0")) || (isInNet(host, "11.210.5.211", "255.255.255.255")) ||
            (isInNet(host, "11.158.5.210", "255.255.255.255")) || (isInNet(host, "181.230.250.1", "255.255.255.255")) || 
            (isInNet(host, "161.10.160.224", "255.255.255.255"))){
                return "DIRECT";
        }    
    
	
     /* Desde Red Corporativa ECI. Usando ZEN globales a traves de tunel GRE */
    return "PROXY zsuser.eci.geci:80";
    }
    else {
       /* usando solo ZCC desde fuera de red corporativa*/
       /* return "PROXY ${GATEWAY_FX}:80; PROXY ${SECONDARY_GATEWAY_FX}:80";*/
		return "DIRECT";
    }
}
