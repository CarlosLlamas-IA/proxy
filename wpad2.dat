            isInNet(host, "10.162.0.0", "255.255.0.0")) {

                return "DIRECT";
            }
            
     // If pac host is the Global IP we are in ECI Corporate Network
    if (globalIP.test(pachost) || (dnsResolve("vecirep.eci.geci") == "10.12.207.25") || (dnsResolve("pac.zscaler.net") == "10.12.198.209")) {
    
      
        // Excepcion a Excepciones 'DIrect'
