
function FindProxyForURL(url, host) {

    var privateIP = /^(0|10|127|192\.168|172\.1[6789]|172\.2[0-9]|172\.3[01]|169\.254|192\.88\.99)\.[0-9.]+$/;
    var resolved_ip = dnsResolve(host);
    var globalIP = /^185\.46\.212\.(88|89|90|91|92|93|97|98)$/;
    var pachost = dnsResolve("pac.zscaler.net");
    
  
    if (isPlainHostName(host))
        return "DIRECT";
    
        // Direcciones locales
    if ((host == "localhost") || shExpMatch(host, "*goskope.com*") || (shExpMatch(host, "localhost.*")) || (host == "127.0.0.1")) {
       return "DIRECT";
    }
    
    
        //Delegaciones compras salida directa
    if ((isInNet(myIpAddress(), "10.200.192.0", "255.255.255.0"))||(isInNet(myIpAddress(), "10.200.194.0", "255.255.255.0"))||
            (isInNet(myIpAddress(), "10.200.193.0", "255.255.255.128"))||(isInNet(myIpAddress(), "10.200.198.0", "255.255.255.0"))||
            (isInNet(myIpAddress(), "10.200.199.0", "255.255.255.128"))||(isInNet(myIpAddress(), "10.201.1.0", "255.255.255.0"))||
            (isInNet(myIpAddress(), "172.26.65.17", "255.255.255.255"))||
            (isInNet(myIpAddress(), "10.201.2.0", "255.255.128.0"))||(isInNet(myIpAddress(), "10.201.4.0", "255.255.255.0"))||
            (isInNet(myIpAddress(), "10.201.6.0", "255.255.255.0"))||(isInNet(myIpAddress(), "10.201.8.0", "255.255.255.0"))||
            (isInNet(myIpAddress(), "10.232.34.0", "255.255.255.192"))) {
                return "DIRECT";
                
    }
    
    //VPN de Logitravel
    if (isInNet(host, "172.25.0.0", "255.255.0.0") || isInNet(host, "172.24.0.0", "255.255.0.0") || isInNet(host, "172.18.5.0", "255.255.255.0")) {
        return "DIRECT";
    }
    
     //Global protect & other
        if (shExpMatch(host, "*acceso.elcorteingles.es*") ||  shExpMatch(url, "*ecica.elcorteingles.es*") ||
            shExpMatch(host, "*acceso2.elcorteingles.es*") ||  shExpMatch(url, "*s2s2.elcorteingles.es*") ||
